{
  "name": "vibe-js",
  "version": "0.1.0",
  "description": "Ultra-lightweight reactive UI framework for smart home and IoT devices",
  "type": "module",
  "main": "dist/vibe.esm.js",
  "module": "dist/vibe.esm.js",
  "unpkg": "dist/vibe.min.js",
  "jsdelivr": "dist/vibe.min.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && rollup -c",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size-check.mjs",
    "prepublishOnly": "npm run build && npm run test && npm run size"
  },
  "keywords": [
    "iot",
    "smart-home",
    "reactive",
    "ui",
    "lightweight",
    "framework"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "jsdom": "^25.0.1",
    "rollup": "^4.24.0",
    "rollup-plugin-esbuild": "^6.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
